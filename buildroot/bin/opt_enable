#!/usr/bin/env python3
"""
opt_enable - Enable Marlin configuration options

Usage: opt_enable OPTION_NAME [OPTION_NAME ...]

For each option name given, uncomments the #define line
in both Configuration.h and Configuration_adv.h files.

Exits with error if any option is not found in either file.
"""
import sys, os, config

def main():
    args = sys.argv[1:]

    for name in args:
        changed = False

        for file in config.FILES:
            if os.path.exists(file):
                if config.enable(file, name):
                    changed = True

        if not changed:
            print(f"ERROR: Can't find {name}")
            exit(1)

if __name__ == "__main__":
    main()
