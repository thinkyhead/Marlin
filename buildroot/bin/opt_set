#!/usr/bin/env python3
"""
opt_set - Set Marlin configuration option values

Usage: opt_set OPTION_NAME VALUE [OPTION_NAME VALUE ...]

For each name/value pair given, sets the #define value in both
Configuration.h and Configuration_adv.h files. If the option is
not found, adds it to Configuration.h via config.add().

Requires an even number of arguments (name value pairs).
"""
import sys, os, config

def main():
    args = sys.argv[1:]
    if len(args) % 2 != 0:
        print("ERROR: Please provide pairs of <name> <value>")
        return

    for i in range(0, len(args), 2):
        name = args[i]
        value = args[i + 1]
        changed = False

        for file in config.FILES:
            if os.path.exists(file):
                if config.set(file, name, value):
                    changed = True

        if not changed:
            config.add(config.FILES[0], name, value)

if __name__ == "__main__":
    main()
